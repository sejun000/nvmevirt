[global]
name=randrw_test
rw=randwrite
#rwmixread=70
bs=128k
offset=0M
size=6G
numjobs=2
time_based=1
runtime=120
group_reporting
direct=1
iodepth=4
ioengine=libaio

[nvme3n1_job]
filename=/dev/nvme3n1
[nvme4n1_job]
filename=/dev/nvme4n1
[nvme5n1_job]
filename=/dev/nvme5n1
[nvme6n1_job]
filename=/dev/nvme6n1
#[mapper_job]
#filename=/dev/mapper/test-mirror
